extends: default

ignore: |
  .git/
  .venv/
  venv/
  nivel-*/dbt_project/target/
  nivel-*/dbt_project/logs/
  nivel-*/dbt_project/dbt_packages/

rules:
  line-length:
    max: 120
    allow-non-breakable-words: true
  document-start: disable
  truthy:
    allowed-values: ['true', 'false', 'on']
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
