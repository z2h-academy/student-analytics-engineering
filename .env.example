# ============================================================
# AE-2026 · variables de entorno del módulo
# Copiar a .env (gitignored) y completar:
#   cp .env.example .env
#   chmod 600 .env
# NUNCA commitear .env ni credenciales reales.
# ============================================================

# ---- Snowflake (warehouse del módulo) ----
SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_ROLE=AE_ROLE
SNOWFLAKE_WAREHOUSE=AE_WH
SNOWFLAKE_DATABASE=AE_ANALYTICS
SNOWFLAKE_SCHEMA=RAW
# Schema donde dbt materializa los modelos (dev). No confundir con
# SNOWFLAKE_SCHEMA=RAW, que usan los scripts del nivel 0.
DBT_SCHEMA=DBT_DEV

# ---- Metabase (metadata en Postgres, no H2) ----
MB_DB_PASS=metabase
# Clave de 16+ caracteres usada por Metabase para cifrar credenciales
# de las conexiones. Cambiarla después rompe las conexiones guardadas.
MB_ENCRYPTION_SECRET_KEY=ae2026-change-me-32-bytes-secret
MB_SITE_URL=http://localhost:3001

# Credenciales del primer usuario admin de Metabase (las usa el
# script nivel-4/scripts/02_metabase_setup.py).
METABASE_ADMIN_EMAIL=admin@ae2026.local
METABASE_ADMIN_PASSWORD=change-me-metabase-admin

# ---- UID/GID del host para el contenedor dbt ----
# En Linux: id -u && id -g. En Codespaces suele ser 1000.
AE_UID=1000
AE_GID=1000
